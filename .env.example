# LLM
OPENAI_API_KEY=sk-your-key-here
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_STRONG_MODEL=gpt-4o

# Database (Postgres + pgvector)
DATABASE_URL=postgresql://incident:incident@localhost:5432/incident_db
POSTGRES_USER=incident
POSTGRES_PASSWORD=incident
POSTGRES_DB=incident_db

# Sentry (cloud free tier)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_WEBHOOK_SECRET=

# Prometheus
PROMETHEUS_URL=http://localhost:9090

# GitHub
GITHUB_TOKEN=
GITHUB_REPO=your-org/incident-demo
GITHUB_WEBHOOK_SECRET=

# Docker remediation safety
DRY_RUN=true
DEMO_CONTAINER_ALLOWLIST=orders-api,payments-api,incident-orders-api,incident-payments-api
DEMO_CONTAINER_LABEL=incident-demo=true
DOCKER_HOST=

# Demo services
ORDERS_API_URL=http://localhost:8001
PAYMENTS_API_URL=http://localhost:8002
INGESTION_URL=http://localhost:8080

# Loop caps (token budget)
SUPERVISOR_MAX_ROUNDS=6
INVESTIGATION_MAX_ROUNDS=3
SPECIALIST_MAX_STEPS=4
CRITIC_MAX_REVISIONS=3
VERIFICATION_MAX_RETRIES=2
CONFIDENCE_PROCEED=0.80
CONFIDENCE_INVESTIGATE=0.50

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=incident-system

# Approver RBAC (comma-separated roles allowed for T3)
T3_APPROVER_ROLES=oncall,sre-lead
